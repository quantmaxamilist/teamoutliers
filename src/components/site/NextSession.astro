---
// Live "next session" for Northern Outliers, worked out in the browser from the published block dates.
import { northernSessions } from '../../data/extra';
interface Props { tone?: 'light' | 'dark' }
const { tone = 'light' } = Astro.props;
---
<div class:list={['ns', `ns--${tone}`]} data-next-session={JSON.stringify(northernSessions)} hidden>
  <span class="ns__pulse" aria-hidden="true"></span>
  <span class="label ns__k">Next session · Penrith RUFC</span>
  <span class="ns__date" data-ns-date></span>
  <span class="ns__count" data-ns-count></span>
</div>
<style>
  .ns { display: inline-grid; grid-template-columns: auto auto; column-gap: 0.9rem; row-gap: 0.15rem; align-items: center; padding: 0.9rem 1.2rem 0.9rem 1rem; border: 1.5px solid currentColor; align-self: flex-start; }
  .ns--light { color: var(--c-black); border-color: rgba(1,1,1,0.2); background: var(--c-white); }
  .ns--dark { color: var(--c-white); border-color: var(--c-line); background: rgba(1,1,1,0.5); }
  .ns__pulse { grid-row: span 3; width: 12px; height: 12px; border-radius: 50%; background: var(--c-coral); box-shadow: 0 0 0 0 rgba(255,97,87,0.6); animation: ns 1.8s infinite; }
  .ns__k { color: var(--c-coral-deep); }
  .ns--dark .ns__k { color: var(--c-coral); }
  .ns__date { font-family: var(--f-display); font-style: italic; font-weight: 900; text-transform: uppercase; font-variation-settings: 'wdth' 115; font-size: 1.5rem; line-height: 1.05; }
  .ns__count { font-family: var(--f-mono); font-size: 0.8rem; }
  @keyframes ns { 70% { box-shadow: 0 0 0 12px rgba(255,97,87,0); } 100% { box-shadow: 0 0 0 0 rgba(255,97,87,0); } }
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-next-session]').forEach((el) => {
    const dates: string[] = JSON.parse(el.dataset.nextSession || '[]');
    const today = new Date(); today.setHours(0, 0, 0, 0);
    const next = dates.map((d) => new Date(d + 'T00:00:00')).find((d) => d >= today);
    if (!next) return;
    const days = Math.round((next.getTime() - today.getTime()) / 864e5);
    el.querySelector('[data-ns-date]')!.textContent = next.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
    el.querySelector('[data-ns-count]')!.textContent = days === 0 ? 'Today' : days === 1 ? 'Tomorrow' : `In ${days} days`;
    el.hidden = false;
  });
</script>
