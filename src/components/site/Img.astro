---
// Photos live in /public/img as <name>.webp (2000px) and <name>-sm.webp (900px).
interface Props { name: string; alt?: string; class?: string; sizes?: string; eager?: boolean; pos?: string }
const { name, alt = '', class: cls, sizes = '(max-width: 760px) 100vw, 50vw', eager = false, pos } = Astro.props;
---
<img
  class={cls}
  src={`/img/${name}.webp`}
  srcset={`/img/${name}-sm.webp 900w, /img/${name}.webp 2000w`}
  sizes={sizes}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  style={pos ? `object-position:${pos}` : undefined}
/>
