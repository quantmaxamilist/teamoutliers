---
// Strand page hero: copy on the left, the strand's signature animation on the right (slot),
// over a dimmed full-bleed photo.
import Img from '../site/Img.astro';
interface Props { kicker: string; title: string; lead?: string; img?: string; pos?: string; cta?: { label: string; href: string; ext?: boolean }[] }
const { kicker, title, lead, img, pos, cta = [] } = Astro.props;
---
<section class="mh">
  {img && <div class="mh__bg" aria-hidden="true"><Img name={img} eager sizes="100vw" alt="" pos={pos} /></div>}
  <div class="wrap mh__grid">
    <div class="mh__copy">
      <p class="label mh__kicker">{kicker}</p>
      <h1 class="h-hero mh__title" data-split>{title}</h1>
      {lead && <p class="lead mh__lead">{lead}</p>}
      {cta.length > 0 && (
        <div class="mh__cta">
          {cta.map((c, i) => <a href={c.href} class:list={['btn', i ? 'btn--white' : 'btn--coral']} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>{c.label}</a>)}
        </div>
      )}
    </div>
    <div class="mh__visual"><slot /></div>
  </div>
</section>
<style>
  .mh { position: relative; background: var(--c-black); padding-top: calc(var(--header-h) + var(--sp-5)); padding-bottom: var(--sp-5); overflow: hidden; min-height: min(92svh, 900px); display: flex; align-items: center; }
  .mh__bg { position: absolute; inset: 0; }
  .mh__bg :global(img) { width: 100%; height: 100%; object-fit: cover; opacity: 0.3; filter: grayscale(0.35) contrast(1.05); }
  .mh::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background:
      radial-gradient(60% 70% at 72% 55%, rgba(255,97,87,0.10), rgba(1,1,1,0) 70%),
      linear-gradient(90deg, rgba(1,1,1,0.82) 0%, rgba(1,1,1,0.45) 45%, rgba(1,1,1,0.2) 100%),
      linear-gradient(180deg, rgba(1,1,1,0.55) 0%, rgba(1,1,1,0) 30%, rgba(1,1,1,0) 70%, rgba(1,1,1,0.7) 100%); }
  .mh__grid { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--sp-5); align-items: center; }
  .mh__copy { display: flex; flex-direction: column; gap: var(--sp-3); }
  .mh__kicker { color: var(--c-coral); }
  .mh__title { font-size: var(--fs-display-2); }
  .mh__lead { color: var(--c-mute); max-width: 46ch; }
  .mh__cta { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-1); }
  @media (max-width: 900px) {
    .mh { min-height: 0; display: block; padding-top: calc(var(--header-h) + var(--sp-4)); }
    .mh__grid { grid-template-columns: minmax(0, 1fr); gap: var(--sp-4); }
    .mh__title { font-size: clamp(1.625rem, 8.2vw, 2.75rem); }
  }
</style>
