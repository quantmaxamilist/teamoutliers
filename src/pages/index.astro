---
import Base from '../layouts/Base.astro';
import StageHero from '../components/home/StageHero.astro';
import Offer from '../components/home/Offer.astro';
import Finder from '../components/home/Finder.astro';
import Marquee from '../components/site/Marquee.astro';
import NextSession from '../components/site/NextSession.astro';
import Img from '../components/site/Img.astro';
import EnquiryBand from '../components/site/EnquiryBand.astro';
import Testimonials from '../components/home/Testimonials.astro';
import { home, titles, northern, method, services } from '../data/site';
---
<Base title={titles.home} description={home.lead}>
  <StageHero />
  <Marquee items={method.principles.map((p) => p.t)} />

  <!-- Intro -->
  <section class="intro light section">
    <div class="wrap intro__grid">
      <div class="intro__copy">
        <p class="statement" data-reveal>{home.lead}</p>
        <p class="lead mute intro__founder" data-reveal>{home.founder}</p>
      </div>
      <figure class="photo intro__photo cut-l" data-reveal>
        <Img name="shot-put" alt="An Outliers athlete throwing in competition" />
      </figure>
    </div>
    <div class="wrap intro__mission">
      <h2 class="h-2" data-reveal>{home.missionTitle}</h2>
      <div class="prose" data-reveal>{home.mission.map((p) => <p>{p}</p>)}</div>
    </div>
  </section>

  <Offer />

  <!-- Northern Outliers news -->
  <section class="north white" aria-labelledby="north-h">
    <div class="north__photo photo">
      <Img name="northern-squad" alt="The Northern Outliers squad at Penrith RUFC" sizes="(max-width: 900px) 100vw, 55vw" />
    </div>
    <div class="north__body">
      <p class="label north__badge" data-reveal>{home.northernNews}</p>
      <h2 id="north-h" class="h-2" data-reveal>{home.northernTitle}</h2>
      <p class="mute" data-reveal>{northern.datesLead}</p>
      <NextSession />
      <ul class="north__dates" data-reveal>
        {northern.dates.map((d) => (
          <li class:list={{ 'is-off': d.d === 'BREAK' }}><span class="label">{d.m}</span><span>{d.d}</span></li>
        ))}
      </ul>
      <div class="north__cta" data-reveal>
        <a href="/northern-outliers" class="btn btn--coral">{home.northernCta}</a>
        <a href={northern.signup} class="btn btn--black" target="_blank" rel="noopener">{northern.signupLabel}</a>
      </div>
    </div>
  </section>

  <!-- Why Outliers + the method -->
  <section class="why dark section">
    <div class="wrap why__grid">
      <div>
        <h2 class="h-1" data-reveal>{home.whyTitle}</h2>
      </div>
      <div class="prose why__copy" data-reveal>
        {home.why.map((p, i) => <p class={i === 0 ? 'statement' : 'lead mute'}>{p}</p>)}
        <a href="/team-outliers" class="btn btn--coral">{home.whyCta}</a>
      </div>
    </div>
    <div class="wrap">
      <ol class="principles">
        {method.principles.map((p) => (
          <li data-reveal>
            <span class="principles__n">{p.n}</span>
            <h3 class="h-3">{p.t}</h3>
            <p class="label mute">{p.s}</p>
          </li>
        ))}
      </ol>
      <p class="principles__more" data-reveal><a href="/method" class="ulink label">{method.kicker.replace(':', '')} →</a></p>
    </div>
  </section>

  <!-- Bespoke -->
  <section class="bespoke light section">
    <div class="wrap bespoke__grid">
      <figure class="photo bespoke__photo cut-r" data-reveal>
        <Img name="mtb" alt="An Outliers athlete mountain biking" />
      </figure>
      <div class="bespoke__copy">
        <h2 class="h-2" data-reveal>{home.bespokeTitle}</h2>
        <p class="lead" data-reveal>{home.bespoke}</p>
        <ul class="bespoke__list" data-reveal>
          {services.programmes[1].bullets.map((b) => <li>{b}</li>)}
        </ul>
        <div data-reveal><a href="/contact?package=bespoke-coaching" class="btn btn--black">Book a Call</a></div>
      </div>
    </div>
  </section>

  <Finder />

  <Testimonials />

  <EnquiryBand />
</Base>

<style>
  .intro__grid { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: var(--sp-6); align-items: center; }
  .intro__founder { margin-top: var(--sp-4); max-width: 52ch; }
  .intro__photo { aspect-ratio: 4 / 4.2; }
  .intro__mission { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6); margin-top: var(--sp-7); padding-top: var(--sp-5); border-top: 2px solid var(--c-black); }


  .north { display: grid; grid-template-columns: 1.1fr 1fr; align-items: stretch; }
  .north__photo { min-height: 520px; clip-path: polygon(0 0, 100% 0, calc(100% - 12%) 100%, 0 100%); }
  .north__body { padding: var(--sp-7) var(--gutter) var(--sp-7) var(--sp-5); display: flex; flex-direction: column; gap: var(--sp-3); max-width: 680px; }
  .north__badge { display: inline-block; align-self: flex-start; background: var(--c-coral); color: var(--c-black); padding: 0.4rem 0.7rem; font-weight: 500; }
  .north__dates { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--c-line-dark); border-left: 1px solid var(--c-line-dark); }
  .north__dates li { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.75rem; border-right: 1px solid var(--c-line-dark); border-bottom: 1px solid var(--c-line-dark); font-weight: 600; font-size: 0.95rem; line-height: 1.3; }
  .north__dates .label { color: var(--c-coral-deep); }
  .north__dates .is-off { background: var(--c-paper); color: var(--c-mute-dark); }
  .north__cta { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-2); }

  .why__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-6); align-items: start; }
  .why__copy { display: flex; flex-direction: column; gap: var(--sp-3); align-items: flex-start; }
  .principles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: var(--sp-7); border-top: 1px solid var(--c-line); }
  .principles li { position: relative; padding: var(--sp-5) var(--sp-4) var(--sp-4) 0; display: flex; flex-direction: column; gap: var(--sp-1); }
  .principles li + li { padding-left: var(--sp-4); border-left: 1px solid var(--c-line); }
  .principles__n { font-family: var(--f-display); font-style: italic; font-weight: 900; font-size: var(--fs-display-1); line-height: 0.85; color: var(--c-coral); font-variation-settings: 'wdth' 125; margin-bottom: var(--sp-2); }
  .principles__more { margin-top: var(--sp-4); color: var(--c-coral); }

  .bespoke__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--sp-6); align-items: center; }
  .bespoke__photo { aspect-ratio: 2 / 2.6; }
  .bespoke__copy { display: flex; flex-direction: column; gap: var(--sp-3); }
  .bespoke__list { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1.5rem; }
  .bespoke__list li { padding-left: 1.25rem; position: relative; font-weight: 500; }
  .bespoke__list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 10px; height: 4px; background: var(--c-coral); transform: skewX(-14deg); }

  @media (max-width: 900px) {
    .intro__grid, .intro__mission, .why__grid, .bespoke__grid { grid-template-columns: minmax(0, 1fr); gap: var(--sp-4); }
    .north { grid-template-columns: minmax(0, 1fr); }
    .north__photo { min-height: 0; aspect-ratio: 16 / 10; clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%); }
    .north__body { padding: var(--sp-5) var(--gutter) var(--sp-6); }
    .principles { grid-template-columns: minmax(0, 1fr); }
    .principles li + li { padding-left: 0; border-left: 0; border-top: 1px solid var(--c-line); }
    .bespoke__photo { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 520px) {
    .north__dates { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .bespoke__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
