---
import Base from '../layouts/Base.astro';
import PageHero from '../components/page/PageHero.astro';
import StrandBar from '../components/page/StrandBar.astro';
import { northern } from '../data/site';
import { products, shopCategory } from '../data/shop';
const ext = { target: '_blank', rel: 'noopener' };

// Filter groups are derived from the product names
const groupOf = (n: string) =>
  /sliders|towel/i.test(n) ? 'accessories'
  : /shorts|trackpants/i.test(n) ? 'shorts'
  : /jacket|midlayer|hoodie/i.test(n) ? 'outerwear'
  : 'tops';
const groups = [
  { id: 'all', label: 'All' },
  { id: 'tops', label: 'Tops' },
  { id: 'shorts', label: 'Shorts & Pants' },
  { id: 'outerwear', label: 'Outerwear' },
  { id: 'accessories', label: 'Accessories' },
].map((g) => ({ ...g, n: g.id === 'all' ? products.length : products.filter((p) => groupOf(p.name) === g.id).length }));

// Lead with the club's sublimated training tee, then group by type (API order within each group).
// A 2x2 feature + 12 tiles fills a 4-column grid exactly; on 2-3 columns it spans the full row.
const featured = 'northern-outliers-seniors-bespoke-training-tee';
const order = ['tops', 'shorts', 'outerwear', 'accessories'];
const list = [...products].sort((a, b) =>
  Number(b.slug === featured) - Number(a.slug === featured) || order.indexOf(groupOf(a.name)) - order.indexOf(groupOf(b.name)));

// "S–3XL", "Size 8–22", '26"–46"', "One Size"
const sizeRange = (s: string[]) => {
  if (s.length < 2) return s[0] ?? '';
  const a = s[0], b = s[s.length - 1];
  const pre = a.match(/^(.*\s)\S+$/)?.[1] ?? '';
  return pre && b.startsWith(pre) ? `${pre}${a.slice(pre.length)}–${b.slice(pre.length)}` : `${a}–${b}`;
};
---
<Base title="Northern Outliers Shop - Outliers" description={northern.shopText} image="rugby-staff">
  <PageHero kicker="02 — Northern Outliers · Kit" title={northern.shopTitle} lead={northern.shopText} img="rugby-staff" />
  <StrandBar current="northern-outliers" />

  <section id="kit" class="light section kit" aria-labelledby="kit-title">
    <div class="wrap">
      <div class="kit__head">
        <div class="stack">
          <p class="label kicker" data-reveal>Northern Outliers × Halbro Sportswear</p>
          <h2 id="kit-title" class="h-2" data-reveal>The kit</h2>
        </div>
        <div class="chips" data-reveal>
          <div class="chips__row" role="group" aria-label="Filter products">
            {groups.map((g, i) => (
              <button type="button" class:list={['chip label', { 'is-on': !i }]} data-filter={g.id} aria-pressed={i ? 'false' : 'true'}>
                {g.label}<sup class="chip__n">{g.n}</sup>
              </button>
            ))}
          </div>
        </div>
      </div>

      <p class="label kit__count" aria-live="polite"><span data-count>{products.length}</span> products</p>

      <ul class="grid is-all" data-grid>
        {list.map((p, i) => (
          <li class:list={['cell', { 'cell--feat': p.slug === featured }]} data-group={groupOf(p.name)}>
            <div class="cell__rv" data-reveal style={`transition-delay:${(i % 4) * 70}ms`}>
              <a href={p.permalink} class:list={['tile', { 'has-alt': p.images.length > 1 }]} {...ext} aria-label={`${p.name}, ${p.price}. Buy on Halbro (opens in a new tab)`}>
                <div class="tile__media">
                  {p.images.slice(0, 2).map((im, n) => (
                    <img
                      class:list={['tile__img', { 'tile__img--alt': n }]}
                      src={im.src}
                      srcset={`${im.sm} 600w, ${im.src} 1400w`}
                      sizes={p.slug === featured ? '(max-width: 1100px) 100vw, 50vw' : '(max-width: 760px) 50vw, (max-width: 1100px) 33vw, 25vw'}
                      alt={n ? '' : im.alt}
                      width="1400" height="1400"
                      loading={i < 4 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  ))}
                  <span class="label tile__idx">{String(i + 1).padStart(2, '0')}</span>
                  {p.attributes.Colour && <span class="label tile__col">{p.attributes.Colour.join(', ')}</span>}
                  <span class="tile__bar" aria-hidden="true"></span>
                </div>
                <div class="tile__meta">
                  <h3 class="tile__name">{p.short.split('/').map((s, k) => <>{k > 0 && <>/<wbr /></>}{s}</>)}</h3>
                  <p class="tile__price">
                    {p.onSale && <s class="mute">{p.regularPrice}</s>}
                    {p.price}
                  </p>
                  {p.sizes.length > 0 && <p class="label tile__sizes">{sizeRange(p.sizes)}</p>}
                  <span class="label tile__buy">Buy on Halbro <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </div>
          </li>
        ))}
      </ul>

      <p class="label mute kit__note" data-reveal>Orders and checkout are handled by Halbro Sportswear.</p>
    </div>
  </section>

  <section class="dark more" aria-label="More from Northern Outliers">
    <span class="more__slash" aria-hidden="true"></span>
    <div class="wrap more__in">
      <a href="/northern-outliers" class="more__link" data-reveal>
        <span class="label more__k">02 — Back to</span>
        <span class="h-2 more__t">Northern Outliers</span>
        <span class="label mute">Rugby pathway, block dates and sign-up</span>
      </a>
      <a href={shopCategory} class="more__link" {...ext} data-reveal>
        <span class="label more__k">Full range</span>
        <span class="h-2 more__t">Halbro <span class="more__arr" aria-hidden="true">↗</span></span>
        <span class="label mute">Northern Outliers on halbro.com</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Head + filter chips ---------- */
  .kit__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--sp-4); align-items: end; margin-bottom: var(--sp-4); }
  .kit__head .stack { gap: var(--sp-2); }
  .chips { min-width: 0; }
  .chips__row { display: flex; gap: 0.5rem; }
  .chip { position: relative; display: inline-flex; align-items: center; gap: 0.35em; min-height: 44px; padding: 0 1.15em; white-space: nowrap; color: var(--c-black); background: var(--c-white); clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); transition: background var(--dur-fast), color var(--dur-fast); }
  .chip:hover { background: var(--c-coral); }
  .chip.is-on { background: var(--c-black); color: var(--c-white); }
  .chip__n { font-size: 0.85em; color: var(--c-coral-deep); vertical-align: super; line-height: 0; }
  .chip.is-on .chip__n { color: var(--c-coral); }
  .chip:hover:not(.is-on) .chip__n { color: var(--c-black); }
  .kit__count { color: var(--c-mute-dark); padding-bottom: var(--sp-2); margin-bottom: var(--sp-3); border-bottom: 2px solid var(--c-black); }
  .kit__note { margin-top: var(--sp-5); padding-top: var(--sp-2); border-top: 1px solid var(--c-line-dark); }

  /* ---------- Grid + tiles ---------- */
  .grid { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--sp-3) var(--sp-2); }
  .cell.is-out { display: none; }
  .grid.is-all .cell--feat { grid-column: span 2; grid-row: span 2; }
  .grid.is-all .cell--feat .tile__media { aspect-ratio: auto; flex: 1; min-height: 0; }
  .grid.is-all .cell--feat .tile__meta { flex: none; }
  .grid.is-all .cell--feat .tile__img { padding: 5%; }
  .grid.is-all .cell--feat .tile__name { font-size: var(--fs-display-3); }
  .grid.is-all .cell--feat .tile__price { font-size: var(--fs-lg); }
  .cell__rv { height: 100%; }
  .tile { display: flex; flex-direction: column; height: 100%; color: var(--c-black); transition: transform var(--dur) var(--ease-out); }
  .tile__media { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--c-white); box-shadow: 0 1px 0 var(--c-line-dark); transition: box-shadow var(--dur) var(--ease-out); }
  .tile__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 7%; transition: transform var(--dur-slow) var(--ease-out), opacity var(--dur) var(--ease-out); }
  .tile__img--alt { opacity: 0; }
  .tile__idx { position: absolute; left: 0.75rem; top: 0.6rem; color: var(--c-coral-deep); }
  .tile__col { position: absolute; right: 0.75rem; top: 0.6rem; color: var(--c-mute-dark); text-align: right; }
  /* the coral slash bar that sweeps across the bottom on hover */
  .tile__bar { position: absolute; left: -6%; bottom: 0; width: 112%; height: 8px; background: var(--c-coral); transform: translateX(-102%) skewX(calc(-1 * var(--slash))); transition: transform var(--dur) var(--ease-out); }
  .tile__meta { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 0.35rem var(--sp-2); padding-top: var(--sp-2); flex: 1; align-content: start; }
  .tile__name { grid-column: 1; font-family: var(--f-display); font-style: italic; font-weight: 900; font-variation-settings: 'wdth' 112; text-transform: uppercase; font-size: var(--fs-lg); line-height: 1.02; overflow-wrap: break-word; min-width: 0; }
  .tile__price { grid-column: 2; grid-row: 1; font-family: var(--f-mono); font-weight: 500; font-size: var(--fs-sm); letter-spacing: 0.02em; white-space: nowrap; padding-top: 0.1em; }
  .tile__price s { margin-right: 0.4em; }
  .tile__sizes { grid-column: 1 / -1; color: var(--c-mute-dark); }
  .tile__buy { grid-column: 1 / -1; align-self: end; margin-top: 0.4rem; justify-self: start; padding-bottom: 2px; background: linear-gradient(currentColor, currentColor) 0 100% / 0 1.5px no-repeat; transition: color var(--dur-fast), background-size var(--dur) var(--ease-out); }

  @media (hover: hover) and (pointer: fine) {
    .tile:hover { transform: translateY(-8px); }
    .tile:hover .tile__media { box-shadow: 0 24px 40px -24px rgba(1, 1, 1, 0.45); }
    .tile:hover .tile__img { transform: scale(1.05); }
    .tile.has-alt:hover .tile__img:not(.tile__img--alt) { opacity: 0; }
    .tile.has-alt:hover .tile__img--alt { opacity: 1; }
    .tile:hover .tile__bar { transform: translateX(0) skewX(calc(-1 * var(--slash))); }
    .tile:hover .tile__buy { color: var(--c-coral-deep); background-size: 100% 1.5px; }
  }
  .tile:focus-visible { outline-offset: 6px; }
  .tile:focus-visible .tile__bar { transform: translateX(0) skewX(calc(-1 * var(--slash))); }

  /* ---------- Dark band ---------- */
  .more { position: relative; overflow: hidden; }
  .more__slash { position: absolute; top: -10%; bottom: -10%; left: 50%; width: 10px; background: var(--c-coral); transform: skewX(calc(-1 * var(--slash))); }
  .more__in { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .more__link { position: relative; display: flex; flex-direction: column; gap: var(--sp-2); padding-block: var(--sp-6); }
  .more__link:first-child { padding-right: var(--sp-6); }
  .more__link:last-child { padding-left: var(--sp-6); }
  .more__k { color: var(--c-coral); }
  .more__t { transition: color var(--dur-fast), transform var(--dur) var(--ease-out); overflow-wrap: break-word; }
  .more__arr { display: inline-block; font-style: normal; transition: transform var(--dur) var(--ease-out); }
  .more__link:hover .more__t { color: var(--c-coral); transform: translateX(8px); }
  .more__link:hover .more__arr { transform: translate(4px, -4px); }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .grid.is-all .cell--feat { grid-column: 1 / -1; grid-row: auto; }
    .grid.is-all .cell--feat .tile__media { aspect-ratio: 2 / 1; flex: none; }
  }
  @media (max-width: 900px) {
    .kit__head { grid-template-columns: minmax(0, 1fr); gap: var(--sp-3); }
    /* chips scroll sideways inside their own row, bleeding to the screen edge */
    .chips { margin-inline: calc(-1 * var(--gutter)); overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .chips::-webkit-scrollbar { display: none; }
    .chips__row { width: max-content; padding-inline: var(--gutter); }
  }
  @media (max-width: 760px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-3) 0.75rem; }
    .tile__meta { grid-template-columns: minmax(0, 1fr); gap: 0.3rem; padding-top: 0.75rem; }
    .tile__price { grid-column: 1; grid-row: auto; }
    .tile__name { font-size: var(--fs-body); }
    .grid.is-all .cell--feat .tile__media { aspect-ratio: 4 / 3; }
    .grid.is-all .cell--feat .tile__meta { grid-template-columns: minmax(0, 1fr) auto; }
    .grid.is-all .cell--feat .tile__price { grid-column: 2; grid-row: 1; }
    .tile__idx { left: 0.5rem; top: 0.4rem; }
    .tile__col { display: none; }
    .more__in { grid-template-columns: minmax(0, 1fr); }
    .more__link:first-child, .more__link:last-child { padding-inline: 0; padding-block: var(--sp-5); }
    .more__link + .more__link { border-top: 1px solid var(--c-line); }
    .more__slash { left: auto; right: 12%; }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { Flip } from 'gsap/Flip';
  gsap.registerPlugin(Flip);

  const grid = document.querySelector<HTMLElement>('[data-grid]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const count = document.querySelector<HTMLElement>('[data-count]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (grid && chips.length) {
    const cells = [...grid.querySelectorAll<HTMLElement>('.cell')];
    let current = 'all';

    const apply = (id: string) => {
      if (id === current) return;
      current = id;
      chips.forEach((c) => {
        const on = c.dataset.filter === id;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });

      const show = (el: HTMLElement) => id === 'all' || el.dataset.group === id;
      const state = reduced ? null : Flip.getState(cells);
      const h0 = grid.offsetHeight;

      gsap.killTweensOf(grid);
      grid.classList.toggle('is-all', id === 'all');
      cells.forEach((el) => {
        el.classList.toggle('is-out', !show(el));
        // tiles brought in by the filter skip the scroll reveal
        el.querySelector('[data-reveal]')?.classList.add('is-in');
      });
      if (count) count.textContent = String(cells.filter(show).length);
      if (!state) return;

      // hold the grid at its old height and ease to the new one: no layout jump
      const h1 = grid.offsetHeight;
      gsap.fromTo(grid, { height: h0 }, { height: h1, duration: 0.5, ease: 'power3.inOut', clearProps: 'height' });
      Flip.from(state, {
        duration: 0.5,
        ease: 'power3.inOut',
        absolute: true,
        stagger: 0.015,
        onEnter: (els) => gsap.fromTo(els, { opacity: 0, scale: 0.88 }, { opacity: 1, scale: 1, duration: 0.42, delay: 0.12, ease: 'power3.out', stagger: 0.03 }),
        onLeave: (els) => gsap.to(els, { opacity: 0, scale: 0.88, duration: 0.22, ease: 'power2.in' }),
      });
    };

    chips.forEach((c) => c.addEventListener('click', () => {
      apply(c.dataset.filter || 'all');
      c.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduced ? 'auto' : 'smooth' });
    }));
  }
</script>
